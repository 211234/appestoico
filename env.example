# Configuración de la Aplicación Estoico
# Copia este archivo a .env y completa con tus valores

# ============================================
# URLs de la API
# ============================================
# URL base de la API principal
API_BASE_URL=https:

# URL base del sitio web (para suscripciones, etc.)
WEB_BASE_URL=

# URL de la API de emblemas
EMBLEMAS_URL=https:

# ============================================
# Deep Links
# ============================================
# Scheme del deep link (debe coincidir con AndroidManifest.xml)
DEEP_LINK_SCHEME=

# Host del deep link para autenticación
DEEP_LINK_HOST=

# ============================================
# Entorno
# ============================================
# Entorno de ejecución: development, staging, production
ENVIRONMENT=

# ============================================
# Configuración de API
# ============================================
# Timeout para peticiones API en segundos
API_TIMEOUT_SECONDS=

# ============================================
# Notas
# ============================================
# - No subas el archivo .env al repositorio (debe estar en .gitignore)
# - Para desarrollo local, puedes cambiar las URLs a localhost
# - Los valores por defecto están configurados para producción

